"help.workflow.title" = "Flujo de medición";
"help.workflow.body" = "Selecciona un atleta activo y un protocolo. Importa un vídeo en tiempo real desde Fotos o Archivos. Marca los eventos, declara los tiempos, calcula, revisa y confirma el guardado. Las mediciones guardadas aparecen en Historial.";
"help.protocols.title" = "Protocolos compatibles";
