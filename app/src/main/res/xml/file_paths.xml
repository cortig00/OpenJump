<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Share only validated trajectory MP4 files, never the complete app cache. -->
    <cache-path
        name="trajectory_exports"
        path="trajectory_exports/" />

    <!--
      Share only the per-file PNG copies staged for an explicitly shared angle frame. This is a
      dedicated directory: the private image store (filesDir/angle-images), the rest of the cache
      and filesDir are not exposed, and each Intent grants exactly one file URI.
    -->
    <cache-path
        name="angle_frame_shares"
        path="shared-angle-frames/" />

    <!-- Share only generated jump summary PNG cards, never the complete app cache. -->
    <cache-path
        name="jump_result_shares"
        path="shared-jump-cards/" />
</paths>
