<?xml version="1.0" encoding="utf-8"?>
<!--
    Símbolo genérico de ángulo para la familia Ángulos del historial: dos rayos con su vértice y el
    arco entre ellos, sin cifras, sin ejes y sin marcas de medida. Es decorativo (la fila ya dice
    cuántos ángulos hay, de quién es y cuándo), así que se pinta sin descripción accesible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48"
    android:tint="?attr/colorControlNormal">
    <!-- Rayos: vértice en (12,36), uno horizontal y otro a ~42°. -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M12,36 L40,36" />
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M12,36 L34,12" />
    <!-- Arco de radio 12 centrado en el vértice, aproximado por una cuadrática tangente. -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M24,36 Q24,30.72 20.11,27.15" />
    <!-- Vértice del ángulo. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,33.6 A2.4,2.4 0 1 0 12,38.4 A2.4,2.4 0 1 0 12,33.6 Z" />
</vector>
